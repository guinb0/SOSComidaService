# Saída de compilação — regenerada por `dotnet build`, não pertence ao repo.
bin/
obj/

# Banco local (SQLite). É estado da máquina: cada dev gera o seu na primeira
# execução, e o SeedInicial popula com o cenário de demonstração.
*.db
*.db-shm
*.db-wal

# Arquivos enviados pelos usuários (fotos de perfil, notas fiscais).
wwwroot/uploads/

# Configuração local / segredos
appsettings.Local.json
appsettings.*.Development.json
.env

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo

# Dependências de Node instaladas aqui por engano (o front é outro repositório).
node_modules/
package.json
pnpm-lock.yaml

# Dados antigos em texto, de antes do SQLite. Tinham senhas e CPFs.
Data/*.txt

# Resultados de teste
TestResults/
